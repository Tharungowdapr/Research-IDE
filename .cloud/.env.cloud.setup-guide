# ResearchIDE Environment Configuration - SETUP GUIDE
# Copy this file to .env.cloud and fill in YOUR values

# ============================================================================
# ⚠️ IMPORTANT: SETUP INSTRUCTIONS
# ============================================================================
# 1. Run the GCP setup script first:
#    cd .cloud && chmod +x gcp-complete-setup.sh && ./gcp-complete-setup.sh
#
# 2. Copy this template:
#    cp .env.cloud.template .env.cloud
#
# 3. Fill in YOUR values below (marked with 👇)
#
# 4. Keep this file SECURE - it contains API keys!
#    Add to .gitignore: .env.cloud
#
# ============================================================================

# ============================================================================
# GCP CONFIGURATION (from setup script output)
# ============================================================================
GCP_PROJECT_ID=research-ide-XXXXX  # 👇 Replace with YOUR Project ID
GCP_REGION=asia-south1

# Storage buckets (auto-created by setup script)
GCS_BUCKET_PDF=research-ide-pdf-cache-research-ide-XXXXX  # 👇 Your PDF bucket
GCS_BUCKET_STATIC=research-ide-static-research-ide-XXXXX  # 👇 Your static bucket
GCS_BUCKET_BACKUPS=research-ide-backups-research-ide-XXXXX # 👇 Your backups bucket

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_TYPE=firestore
FIRESTORE_PROJECT_ID=${GCP_PROJECT_ID}
FIRESTORE_COLLECTION_PREFIX=research_ide

# ============================================================================
# SECURITY KEYS (auto-created by setup script)
# ============================================================================
# These are automatically created and stored in Google Secret Manager
# Cloud Run will inject them automatically - you can leave these blank
SECRET_KEY=auto-injected-from-secret-manager
ENCRYPTION_KEY=auto-injected-from-secret-manager

# ============================================================================
# LLM CONFIGURATION - GOOGLE GEMINI (Lower Cost Option)
# ============================================================================
LLM_PROVIDER=gemini
GEMINI_API_KEY=👇-PASTE-YOUR-GEMINI-API-KEY-HERE-👇

# How to get Gemini API Key:
# 1. Go to: https://aistudio.google.com/apikey
# 2. Click "Create API key"
# 3. Copy and paste here
# 4. Keep this SECRET!

# ============================================================================
# OPTIONAL: BACKUP LLM PROVIDERS (for redundancy)
# ============================================================================
# Leave these blank if you only use Gemini (cheaper!)

# OpenAI (backup)
# OPENAI_API_KEY=your-openai-key-optional

# Anthropic (backup)
# ANTHROPIC_API_KEY=your-anthropic-key-optional

# Groq (free tier: 30 req/min)
# GROQ_API_KEY=your-groq-key-optional

# ============================================================================
# GOOGLE OAUTH 2.0 (for Login)
# ============================================================================
# 1. Go to: https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Credentials (Web Application)
# 3. Set Authorized redirect URIs:
#    - https://YOUR-BACKEND-URL/auth/callback
#    - http://localhost:8000/auth/callback (for local testing)
# 4. Copy Client ID and Secret below

GOOGLE_CLIENT_ID=👇-YOUR-GOOGLE-CLIENT-ID-HERE-👇.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=👇-YOUR-GOOGLE-CLIENT-SECRET-HERE-👇

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
# After deployment, you'll have these URLs:
# Backend: https://research-ide-backend-xxxxx-as.a.run.app
# Frontend: https://storage.googleapis.com/research-ide-static-xxxxx/

FRONTEND_URL=https://YOUR-FRONTEND-URL-AFTER-DEPLOYMENT  # 👇 Update after deploying

# Allowed origins for CORS
ALLOWED_ORIGINS=["https://research-ide-backend-xxxxx-as.a.run.app","https://storage.googleapis.com"]

# ============================================================================
# LOGGING & MONITORING (Google Cloud Logging - FREE)
# ============================================================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
ENABLE_STRUCTURED_LOGGING=true
ENABLE_REQUEST_LOGGING=true

# ============================================================================
# OPTIONAL: ZOTERO INTEGRATION (for paper exports)
# ============================================================================
# Leave blank if not using Zotero
ZOTERO_API_KEY=  # 👇 Optional: Your Zotero API key
ZOTERO_USER_ID=  # 👇 Optional: Your Zotero User ID

# ============================================================================
# OPTIONAL: EXTERNAL SERVICE INTEGRATIONS
# ============================================================================
# These are optional - leave blank if not needed

# Crossref (paper metadata)
CROSSREF_API_EMAIL=  # 👇 Optional: Your email for Crossref API

# Semantic Scholar API
SEMANTICSCHOLAR_API_KEY=  # 👇 Optional

# OpenAlex API
OPENALEXPAPERSAPI=  # 👇 Optional

# ============================================================================
# RATE LIMITING (to stay on free tier)
# ============================================================================
# These help you stay within free tier limits

REQUESTS_PER_MINUTE=60      # Stay under Cloud Run limits
REQUESTS_PER_DAY=1000       # Daily request limit
FIRESTORE_READ_QUOTA=40000  # Leave 10K buffer from 50K free limit
FIRESTORE_WRITE_QUOTA=15000 # Leave 5K buffer from 20K free limit

# ============================================================================
# DATABASE BACKUP (automatic daily backups to Cloud Storage)
# ============================================================================
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily      # daily, weekly, or monthly
BACKUP_BUCKET=${GCS_BUCKET_BACKUPS}
BACKUP_RETENTION_DAYS=30    # Keep 30 days of backups

# ============================================================================
# ENVIRONMENT
# ============================================================================
ENVIRONMENT=production
DEBUG=false

# ============================================================================
# DEPLOYMENT TRACKER (for monitoring)
# ============================================================================
DEPLOYMENT_VERSION=1.0.0
DEPLOYMENT_DATE=2026-06-03
DEPLOYED_BY=user@example.com  # 👇 Your email

# ============================================================================
# 🚀 DEPLOYMENT CHECKLIST
# ============================================================================
# Before you start, you should have:
# 
# ✅ Google Account with billing enabled
# ✅ gcloud CLI installed and authenticated
# ✅ GCP project created (or run gcp-complete-setup.sh)
# ✅ Gemini API key generated
# ✅ Google OAuth credentials created (optional, for social login)
# ✅ All values below filled in
#
# Then run:
# 1. python .cloud/migrate_to_firestore.py --project GCP_PROJECT_ID
# 2. .cloud/deploy-backend.sh GCP_PROJECT_ID
# 3. .cloud/deploy-frontend.sh GCP_PROJECT_ID
#
# ============================================================================
