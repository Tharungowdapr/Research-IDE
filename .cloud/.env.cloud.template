"""
Cloud Environment Configuration Template
- Copy to .env.cloud and fill in your values
- This will be loaded by Cloud Run via Cloud Secret Manager
"""

# ============================================================================
# GCP CONFIGURATION
# ============================================================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-south1
GCP_BUCKET_PDF_CACHE=research-ide-pdf-cache-prod

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Option 1: Cloud Firestore (RECOMMENDED - Free tier: 1GB, 50K reads/day)
DATABASE_TYPE=firestore
FIRESTORE_PROJECT_ID=${GCP_PROJECT_ID}
FIRESTORE_COLLECTION_PREFIX=research_ide

# Option 2: Cloud SQL PostgreSQL (if you prefer SQL, ~$15/month minimum)
# DATABASE_TYPE=postgresql
# DATABASE_URL=postgresql://user:password@cloudsql-proxy:5432/research_ide

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# Secret key for JWT tokens (generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=your-secret-key-min-32-chars-generate-new-one!

# Encryption key for storing API keys (generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
ENCRYPTION_KEY=your-encryption-key-min-32-chars!

# OAuth 2.0 Configuration (for Google Login)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# ============================================================================
# LLM PROVIDERS
# ============================================================================
# Primary: Google Gemini (lowest cost, integrated with GCP)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-google-gemini-api-key

# Optional: OpenAI (backup provider)
OPENAI_API_KEY=your-openai-api-key

# Optional: Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: Groq (free tier: 30 requests/minute)
GROQ_API_KEY=your-groq-api-key

# ============================================================================
# CORS & ALLOWED ORIGINS
# ============================================================================
# Frontend URL (where Cloud Run hosts the frontend)
FRONTEND_URL=https://research-ide.example.com
# Or use Cloud Run's auto domain:
# FRONTEND_URL=https://research-ide-frontend-xxxxx-as.a.run.app

ALLOWED_ORIGINS=["https://research-ide.example.com", "https://research-ide-frontend-xxxxx-as.a.run.app"]

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_LEVEL=INFO
ENABLE_STRUCTURED_LOGGING=true
# Google Cloud Logging will capture all stdout/stderr automatically

# ============================================================================
# OPTIONAL: ZOTERO INTEGRATION
# ============================================================================
ZOTERO_API_KEY=your-zotero-api-key
ZOTERO_USER_ID=your-zotero-user-id

# ============================================================================
# OPTIONAL: PLUGIN SYSTEM
# ============================================================================
ENABLE_PLUGIN_SYSTEM=true
PLUGIN_TIMEOUT_SECONDS=30

# ============================================================================
# OPTIONAL: EXTERNAL SERVICE INTEGRATIONS
# ============================================================================
# Crossref Plugin
CROSSREF_API_EMAIL=your-email@example.com

# Paper metadata services
SEMANTICSCHOLAR_API_KEY=optional
OPENALEXPAPERSAPI=optional

# ============================================================================
# RATE LIMITING (for free tier)
# ============================================================================
REQUESTS_PER_MINUTE=60
REQUESTS_PER_DAY=1000

# ============================================================================
# DATABASE BACKUP (Cloud Storage)
# ============================================================================
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily  # daily, weekly, monthly
BACKUP_BUCKET=research-ide-backups-prod
BACKUP_RETENTION_DAYS=30

# ============================================================================
# ENVIRONMENT
# ============================================================================
ENVIRONMENT=production
DEBUG=false
