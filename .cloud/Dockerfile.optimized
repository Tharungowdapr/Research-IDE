# Dockerfile Optimizations for Cloud Run (Minimal Cost)
# This file contains optimization strategies for backend Dockerfile

FROM python:3.11-slim as builder

# Install build dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp
COPY backend/requirements.txt .

# Create wheels for faster installation
RUN pip install --user --no-cache-dir --wheel --no-deps --wheel-dir /tmp/wheels -r requirements.txt

# ============================================================================
# Final stage - minimal image
# ============================================================================
FROM python:3.11-slim

# Install only runtime dependencies (no build tools)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy wheels from builder
COPY --from=builder /tmp/wheels /tmp/wheels
COPY backend/requirements.txt .

# Install Python packages from wheels (faster, no compilation)
RUN pip install --no-cache-dir --no-index --find-links /tmp/wheels -r requirements.txt

# Copy application code
COPY backend/ .

# Create non-root user for security
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Health check for Cloud Run
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/api/health || exit 1

# Cloud Run requires listening on PORT environment variable
ENV PORT=8080
EXPOSE 8080

# Use uvicorn with optimizations for Cloud Run
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "2"]

# ============================================================================
# OPTIMIZATION NOTES
# ============================================================================
# 1. Multi-stage build: Reduces final image size (~500MB → ~250MB)
# 2. python:3.11-slim: Base image is only 125MB (vs 1GB for full Python)
# 3. No build tools in final image: Smaller attack surface
# 4. Pre-built wheels: Faster deployments (no compilation on Cloud Run)
# 5. Single-user process: Lower memory usage
# 6. Health check: Enables Cloud Run's automatic restarts
# 7. 2 workers: Optimal for 512Mi Cloud Run instances
#
# Estimated Cloud Run costs with these optimizations:
# • Memory: 512Mi (minimum for LLM calls)
# • CPU: 1 vCPU (auto-scales)
# • Concurrency: 10-50 per instance (depends on workload)
# • Monthly: ~$0 (within free tier)
