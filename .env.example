# ResearchIDE - Environment Variables
# Copy this to .env and fill in your values

# ── Security (REQUIRED) ──
SECRET_KEY=change-this-to-a-random-64-char-string
ENCRYPTION_KEY=change-this-to-a-random-32-char-string

# Generate both with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# ── Database ──
DATABASE_URL=sqlite:///./research_ide.db

# For Neon Postgres (free tier):
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/research_ide?sslmode=require

# ── LLM Provider ──
DEFAULT_LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here

# Alternative providers (optional):
# OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key
# GEMINI_API_KEY=your-gemini-key

# ── CORS ──
ALLOWED_ORIGINS=["http://localhost:3000"]

# For deployed frontend, add its URL:
# ALLOWED_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]

# ── Ollama (local only, optional) ──
# OLLAMA_BASE_URL=http://localhost:11434
