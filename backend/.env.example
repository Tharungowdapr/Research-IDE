# ResearchIDE Configuration — copy to .env and fill in values
# NEVER commit .env to version control

# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# REQUIRED: Must be exactly 32 characters
ENCRYPTION_KEY=

# Set to True only for local development
DEBUG=false

# Database (default: SQLite for dev; use PostgreSQL for production)
# DATABASE_URL=postgresql://user:pass@localhost:5432/research_ide

# Redis (for Celery task queue)
# REDIS_URL=redis://localhost:6379/0

# LLM Provider (ollama | openai | anthropic | groq | gemini | cohere)
DEFAULT_LLM_PROVIDER=ollama

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# Optional: API keys for cloud providers (also settable via UI per-user)
# GEMINI_API_KEY=

# Optional: Semantic Scholar API key for higher rate limits (100 req/5min → 1 req/s)
# S2_API_KEY=
